# ===== Aplicação =====
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200

# ===== Banco de dados (MongoDB) =====
# Use MONGODB_URI ou DATABASE_URL
MONGODB_URI=mongodb://127.0.0.1:27017/patrify
DATABASE_URL=mongodb://127.0.0.1:27017/patrify
MONGODB_DB_NAME=patrify
DB_POOL_MAX=10

# ===== Autenticação =====
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_uma_chave_com_pelo_menos_32_caracteres
JWT_EXPIRES_IN=2h
JWT_ISSUER=patrify-api
JWT_AUDIENCE=patrify-app

# ===== E-mail (recuperação de senha) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app
EMAIL_FROM=Patrify <seu_email@gmail.com>

# Compatibilidade com a configuração antiga (Gmail)
# EMAIL_USER=seu_email@gmail.com
# EMAIL_PASS=sua_senha_de_app

# ===== Google Maps (pontos de descarte) =====
GOOGLE_MAPS_API_KEY=sua_chave_do_google_maps

# ===== Upload de imagens =====
# Se BLOB_READ_WRITE_TOKEN existir, usa Vercel Blob; caso contrário, grava em UPLOAD_DIR.
BLOB_READ_WRITE_TOKEN=
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ===== Integrações =====
BRASIL_API_URL=https://brasilapi.com.br/api/cnpj/v1
